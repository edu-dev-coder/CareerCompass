datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Country {
  id              String       @id @default(uuid())
  countryName     String       @unique
  isoCode         String       @unique
  currencyCode    String
  defaultLanguage String
  createdAt       DateTime     @default(now())
  tenants         Tenant[]
  assessments     Assessment[]
}

model Tenant {
  id         String     @id @default(uuid())
  countryId  String
  country    Country    @relation(fields: [countryId], references: [id])
  schoolName String
  schoolCode String     @unique
  address    String?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  users      User[]
  students   Student[]
}

model User {
  id           String     @id @default(uuid())
  tenantId     String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  email        String     @unique
  passwordHash String
  userRole     String     // 'super_admin', 'country_admin', 'school_admin', 'counsellor', 'teacher', 'parent', 'student'
  firstName    String
  lastName     String
  phoneNumber  String?
  isVerified   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  students     Student[]  @relation("ParentToStudent")
  auditLogs    SecurityAuditLog[]
}

model Student {
  id                    String              @id @default(uuid())
  tenantId              String?
  tenant                Tenant?             @relation(fields: [tenantId], references: [id])
  parentId              String?
  parent                User?               @relation("ParentToStudent", fields: [parentId], references: [id])
  accessCodeId          String?             @unique
  accessCode            AccessCode?         @relation(fields: [accessCodeId], references: [id])
  currentGradeLevel     Int
  academicTrack         String              // 'primary', 'basic', 'junior_secondary', 'senior_secondary'
  streamPreference      String              @default("none")
  dateOfBirth           String              // YYYY-MM-DD
  gender                String
  parentalConsentSigned Boolean             @default(false)
  consentSignedAt       DateTime?
  createdAt             DateTime            @default(now())
  pii                   StudentPii?
  grades                StudentGrade[]
  sessions              AssessmentSession[]
}

model StudentPii {
  studentId          String   @id
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  encryptedFirstName String
  encryptedLastName  String
  encryptedEmail     String?
  iv                 String   // Hex formatted initialization vector
}

model StudentGrade {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         String   // e.g. 'Term 1 2026'
  subjectName  String
  numericScore Float
  letterGrade  String?  // e.g. 'A1', 'C6'
  createdAt    DateTime @default(now())

  @@unique([studentId, subjectName, term])
}

model Assessment {
  id          String              @id @default(uuid())
  countryId   String
  country     Country             @relation(fields: [countryId], references: [id])
  title       String
  version     String
  type        String              // 'screening', 'standard', 'comprehensive'
  stage       String              // 'primary', 'basic', 'junior_secondary', 'senior_secondary'
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  questions   Question[]
  sessions    AssessmentSession[]
}

model Question {
  id              String             @id @default(uuid())
  assessmentId    String
  assessment      Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  dimensionCode   String             // e.g. 'RIASEC_R', 'COG_NUM'
  itemType        String             // 'multiple_choice', 'likert', 'card_sort'
  questionText    String
  mediaUrl        String?
  metadata        String             @default("{}") // JSON string options
  difficultyB     Float              @default(0.0)
  discriminationA Float              @default(1.0)
  guessingC       Float              @default(0.0)
  createdAt       DateTime           @default(now())
  responses       QuestionResponse[]
}

model AssessmentSession {
  id                  String                 @id @default(uuid())
  studentId           String
  student             Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessmentId        String
  assessment          Assessment             @relation(fields: [assessmentId], references: [id])
  startedAt           DateTime               @default(now())
  completedAt         DateTime?
  currentAbilityTheta Float                  @default(0.0)
  metadata            String                 @default("{}") // JSON string
  responses           QuestionResponse[]
  scores              SessionScore[]
  recommendations     CareerRecommendation[]
}

model QuestionResponse {
  id            String            @id @default(uuid())
  sessionId     String
  session       AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question          @relation(fields: [questionId], references: [id])
  rawResponse   String
  isCorrect     Boolean?
  responseTimeMs Int?
  createdAt     DateTime          @default(now())

  @@unique([sessionId, questionId])
}

model SessionScore {
  id                    String            @id @default(uuid())
  sessionId             String
  session               AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  dimensionCode         String
  rawScore              Float
  standardTScore        Float
  irtAbilityTheta       Float?
  confidenceLower       Float
  confidenceUpper       Float
  createdAt             DateTime          @default(now())

  @@unique([sessionId, dimensionCode])
}

model CareerRecommendation {
  id             String            @id @default(uuid())
  sessionId      String
  session        AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  occupationId   String            // References our career taxonomy keys e.g. 'OC-SFT-001'
  matchScore     Float
  matchCategory  String            // 'Strong Fit', 'Stretch Fit', 'Requires Dev'
  evidence       String            // JSON string summary
  createdAt      DateTime          @default(now())
}

model SecurityAuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actionType String
  ipAddress  String
  userAgent  String?
  details    String   @default("{}")
  createdAt  DateTime @default(now())
}

model AccessCode {
  id        String    @id @default(uuid())
  code      String    @unique
  status    String    @default("unused") // "unused", "used"
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  student   Student?
}
